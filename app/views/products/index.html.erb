<section class="hero is-info is-bold">
  <div class="hero-body">
    <div class="container">
      <h1 class="title">Product Catalog</h1>
      <h2 class="subtitle">Premium Audio Equipment</h2>
    </div>
  </div>
</section>

<div class="container mt-5">
  <div class="box">
    <%= form_with url: products_path, method: :get, local: true do |f| %>
      <div class="columns">
        <div class="column is-4">
          <%= f.text_field :keyword, value: params[:keyword], class: "input", placeholder: "Search for gear..." %>
        </div>
        <div class="column is-3">
          <div class="select is-fullwidth">
            <%= f.collection_select :category_id, @categories, :id, :category_name, include_blank: "All Categories", selected: params[:category_id] %>
          </div>
        </div>
        <div class="column is-3">
          <div class="select is-fullwidth">
            <%= f.select :filter, [["New Products", "new"], ["Recently Updated", "updated"]], include_blank: "No Extra Filters", selected: params[:filter] %>
          </div>
        </div>
        <div class="column is-2">
          <%= f.submit "Filter", class: "button is-info is-fullwidth" %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="columns is-multiline">
    <% @products.each do |product| %>
      <div class="column is-4">
        <div class="card">
          <div class="card-image">
            <figure class="image is-4by3">
              <% if product.image.attached? %>
                <%= image_tag product.image %>
              <% else %>
                <img src="https://via.placeholder.com/400x300" alt="No image">
              <% end %>
            </figure>
          </div>
          <div class="card-content">
            <p class="title is-5"><%= product.product_name %></p>
            <p class="subtitle is-6 has-text-success"><%= number_to_currency(product.price) %></p>
            <%= link_to "Details", product_path(product), class: "button is-link is-small is-fullwidth" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="section">
    <nav class="pagination is-centered">
      <%= paginate @products %>
    </nav>
  </div>
</div>