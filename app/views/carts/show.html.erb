<div class="container mt-5">
  <h1 class="title">Your Shopping Cart</h1>

  <% if @products.any? %>
    <div class="columns">
      <div class="column is-8">
        <div class="box">
          <table class="table is-fullwidth is-hoverable">
            <thead>
              <tr>
                <th>Product</th>
                <th class="has-text-centered">Quantity</th>
                <th class="has-text-right">Price</th>
                <th class="has-text-right">Total</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% @products.each do |product| %>
                <% quantity = @cart[product.id.to_s].to_i %>
                <tr>
                  <td class="is-vcentered">
                    <strong><%= product.product_name %></strong>
                  </td>
                  <td class="is-vcentered has-text-centered">
                    <%= form_with url: update_cart_path(product.id), method: :post, local: true, class: "is-flex is-justify-content-center" do |f| %>
                      <div class="field has-addons">
                        <div class="control">
                          <%= f.number_field :quantity, value: quantity, min: 1, class: "input is-small", style: "width: 60px;" %>
                        </div>
                        <div class="control">
                          <%= f.submit "Update", class: "button is-small is-info is-light" %>
                        </div>
                      </div>
                    <% end %>
                  </td>
                  <td class="is-vcentered has-text-right"><%= number_to_currency(product.price) %></td>
                  <td class="is-vcentered has-text-right"><%= number_to_currency(product.price * quantity) %></td>
                  <td class="is-vcentered has-text-right">
                    <%= button_to remove_from_cart_path(product.id), method: :post, class: "button is-danger is-small is-light" do %>
                      <span class="icon"><i class="fas fa-trash"></i></span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <div class="column is-4">
        <div class="box has-background-light">
          <h2 class="title is-4">Order Summary</h2>
          <hr>
          <div class="level is-mobile">
            <div class="level-left">
              <div class="level-item"><p class="is-size-5">Subtotal</p></div>
            </div>
            <div class="level-right">
              <div class="level-item"><p class="is-size-5 has-text-weight-bold"><%= number_to_currency(@subtotal) %></p></div>
            </div>
          </div>
          <p class="is-size-7 has-text-grey mb-4">Taxes and shipping calculated at checkout.</p>
          
          <%= button_to "Proceed to Checkout", checkout_create_path, method: :post, data: { turbo: false }, class: "button is-success is-fullwidth is-large" %>
          
          <%= link_to "Continue Shopping", products_path, class: "button is-ghost is-fullwidth mt-2" %>
        </div>
      </div>
    </div>
  <% else %>
    <div class="box has-text-centered py-6">
      <span class="icon is-large has-text-grey-light mb-4">
        <i class="fas fa-shopping-cart fa-3x"></i>
      </span>
      <h2 class="title is-4 has-text-grey">Your cart is currently empty.</h2>
      <p class="subtitle is-6 has-text-grey-light mb-5">Looks like you haven't added anything to your cart yet.</p>
      <%= link_to "Browse Catalog", products_path, class: "button is-dark" %>
    </div>
  <% end %>
</div>