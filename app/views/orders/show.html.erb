<div class="container mt-5">
  <nav class="breadcrumb" aria-label="breadcrumbs">
    <ul>
      <li><%= link_to "Home", root_path %></li>
      <li><%= link_to "Order History", orders_path %></li>
      <li class="is-active"><a href="#" aria-current="page">Order #<%= @order.id %></a></li>
    </ul>
  </nav>

  <div class="level is-mobile mt-4">
    <div class="level-left">
      <h1 class="title is-2">Order Details: #<%= @order.id %></h1>
    </div>
    <div class="level-right">
      <span class="tag is-success is-medium"><%= @order.status.capitalize %></span>
    </div>
  </div>
  
  <p class="subtitle is-6 has-text-grey mb-5">
    Placed on <%= @order.created_at.strftime("%B %d, %Y at %I:%M %p") %>
  </p>

  <div class="box shadow-smooth">
    <div class="table-container">
      <table class="table is-fullwidth is-striped is-hoverable">
        <thead>
          <tr>
            <th>Product</th>
            <th class="has-text-centered">Quantity</th>
            <th class="has-text-right">Unit Price</th>
            <th class="has-text-right">Total</th>
          </tr>
        </thead>
        <tbody>
          <% @order.line_items.each do |item| %>
            <tr>
              <td class="is-vcentered"><strong><%= item.product.product_name %></strong></td>
              <td class="is-vcentered has-text-centered"><%= item.quantity %></td>
              <td class="is-vcentered has-text-right"><%= number_to_currency(item.price) %></td>
              <td class="is-vcentered has-text-right"><%= number_to_currency(item.price * item.quantity) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <hr>

    <div class="columns is-mobile">
      <div class="column is-6 is-offset-6 has-text-right">
        <p class="is-size-6 mb-2">
          <span class="has-text-grey mr-4">Subtotal:</span> 
          <strong><%= number_to_currency(@order.subtotal) %></strong>
        </p>

        <%# The .to_f safely handles nil values so the page doesn't crash %>
        <% if @order.gst.to_f > 0 %>
          <p class="is-size-6 mb-1">
            <span class="has-text-grey mr-4">GST:</span> 
            <%= number_to_currency(@order.gst) %>
          </p>
        <% end %>

        <% if @order.pst.to_f > 0 %>
          <p class="is-size-6 mb-1">
            <span class="has-text-grey mr-4">PST:</span> 
            <%= number_to_currency(@order.pst) %>
          </p>
        <% end %>

        <% if @order.hst.to_f > 0 %>
          <p class="is-size-6 mb-1">
            <span class="has-text-grey mr-4">HST:</span> 
            <%= number_to_currency(@order.hst) %>
          </p>
        <% end %>

        <div class="mt-4 pt-3" style="border-top: 1px solid #eee;">
          <p class="is-size-4 has-text-weight-bold">
            <span class="has-text-grey mr-4">Total:</span> 
            <%= number_to_currency(@order.total) %>
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="buttons mt-5">
    <%= link_to orders_path, class: "button is-link is-light" do %>
      <span class="icon"><i class="fas fa-arrow-left"></i></span>
      <span>Back to Order History</span>
    <% end %>
  </div>
</div>

<style>
  .shadow-smooth {
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    border-radius: 8px;
  }
</style>