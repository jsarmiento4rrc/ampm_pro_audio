<div class="container">
  <h1 class="title mt-5">My Order History</h1>

  <% if @orders.any? %>
    <table class="table is-fullwidth is-striped">
      <thead>
        <tr>
          <th>Order #</th>
          <th>Date</th>
          <th>Status</th>
          <th>Total</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @orders.each do |order| %>
          <tr>
            <td><%= order.id %></td>
            <td><%= order.created_at.strftime("%B %d, %Y") %></td>
            <td><span class="tag is-info"><%= order.status.capitalize %></span></td>
            <td><%= number_to_currency(order.total) %></td>
            <td><%= link_to 'View Details', order_path(order), class: 'button is-small is-link' %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="notification is-light">
      You haven't placed any orders yet.
    </div>
  <% end %>
</div>