<!DOCTYPE html>
<html>
  <head>
    <title>AmPm Pro Audio</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bulma@0.9.4/css/bulma.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="has-navbar-fixed-top-desktop">
    <nav class="navbar is-dark is-fixed-top" role="navigation" aria-label="main navigation">
      <div class="container">
        <div class="navbar-brand">
          <%= link_to root_path, class: "navbar-item" do %>
            <strong class="is-size-4">AMPM PRO AUDIO</strong>
          <% end %>

          <a role="button" class="navbar-burger" aria-label="menu" aria-expanded="false" data-target="navbarMain">
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
          </a>
        </div>

        <div id="navbarMain" class="navbar-menu">
          <div class="navbar-start">
            <%= link_to "Products", products_path, class: "navbar-item" %>
          </div>

          <div class="navbar-end">
            <div class="navbar-item">
              <%= link_to cart_path, class: "button is-primary" do %>
                <span class="icon">
                  <i class="fas fa-shopping-cart"></i>
                </span>
                <span>Cart (<%= session[:cart]&.values&.sum || 0 %>)</span>
              <% end %>
            </div>

            <% if customer_signed_in? %>
              <div class="navbar-item has-dropdown is-hoverable">
                <a class="navbar-link">
                  <span class="icon"><i class="fas fa-user"></i></span>
                  <span><%= current_customer.email %></span>
                </a>
                <div class="navbar-dropdown is-right">
                  <%= link_to "Edit Profile", edit_customer_registration_path, class: "navbar-item" %>
                  <%= link_to "Order History", orders_path, class: "navbar-item" %>
                  <hr class="navbar-divider">
                  <%= link_to "Sign Out", destroy_customer_session_path, data: { "turbo-method": :delete }, class: "navbar-item has-text-danger" %>
                </div>
              </div>
            <% else %>
              <div class="navbar-item">
                <div class="buttons">
                  <%= link_to "Sign Up", new_customer_registration_path, class: "button is-light" %>
                  <%= link_to "Log In", new_customer_session_path, class: "button is-info" %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </nav>

    <div class="container mt-6 pt-5">
      <%= render_breadcrumbs %>
    </div>

    <div class="container mt-2">
      <% flash.each do |type, message| %>
        <div class="notification <%= type == 'notice' ? 'is-success' : 'is-danger' %> is-light">
          <button class="delete"></button>
          <%= message %>
        </div>
      <% end %>
    </div>

    <main class="section">
      <div class="container">
        <%= yield %>
      </div>
    </main>

    <footer class="footer">
      <div class="content has-text-centered">
        <p>
          <strong>AMPM PRO AUDIO</strong> &copy; <%= Time.now.year %> - RRC Agile Project
        </p>
      </div>
    </footer>

    <script>
      document.addEventListener('turbo:load', () => {
        // Handle Navbar Burger Toggle
        const $navbarBurgers = Array.prototype.slice.call(document.querySelectorAll('.navbar-burger'), 0);
        if ($navbarBurgers.length > 0) {
          $navbarBurgers.forEach( el => {
            el.addEventListener('click', () => {
              const target = el.dataset.target;
              const $target = document.getElementById(target);
              el.classList.toggle('is-active');
              $target.classList.toggle('is-active');
            });
          });
        }

        // Handle Flash Message Deletion
        (document.querySelectorAll('.notification .delete') || []).forEach(($delete) => {
          const $notification = $delete.parentNode;
          $delete.addEventListener('click', () => {
            $notification.parentNode.removeChild($notification);
          });
        });
      });
    </script>
  </body>
</html>