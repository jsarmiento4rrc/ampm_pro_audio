<!DOCTYPE html>
<html>
  <head>
    <title>AMPM PRO AUDIO</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bulma@0.9.4/css/bulma.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="navbar is-dark" role="navigation" aria-label="main navigation">
      <div class="container">
        <div class="navbar-brand">
          <%= link_to "AMPM PRO AUDIO", root_path, class: "navbar-item title is-4 has-text-white mb-0", style: "text-decoration: underline;" %>
        </div>

        <div class="navbar-menu is-active">
          <div class="navbar-start">
            <%= link_to "Products", root_path, class: "navbar-item" %>
            
            <%= link_to "About Us", page_path('about'), class: "navbar-item" %>
            <%= link_to "Contact", page_path('contact'), class: "navbar-item" %>
          </div>

          <div class="navbar-end">
            <div class="navbar-item">
              <div class="buttons">
                <%= link_to cart_path, class: "button is-dark" do %>
                  <span class="icon"><i class="fas fa-shopping-cart"></i></span>
                  <% cart_count = session[:cart].present? ? session[:cart].values.map(&:to_i).sum : 0 %>
                  <span>Cart (<%= cart_count %>)</span>
                <% end %>

                <% if customer_signed_in? %>
                  <div class="navbar-item has-dropdown is-hoverable">
                    <a class="navbar-link has-text-light">
                      <span class="icon"><i class="fas fa-user"></i></span>
                      <span><%= current_customer.email %></span>
                    </a>
                    <div class="navbar-dropdown is-right">
                      <%= link_to "Order History", orders_path, class: "navbar-item" %>
                      <hr class="navbar-divider">
                      <%= button_to "Log Out", destroy_customer_session_path, method: :delete, class: "navbar-item has-text-danger", style: "width: 100%; text-align: left; background: none; border: none; cursor: pointer;" %>
                    </div>
                  </div>
                <% else %>
                  <%= link_to "Log In", new_customer_session_path, class: "button is-light" %>
                  <%= link_to "Sign Up", new_customer_registration_path, class: "button is-primary" %>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <% if notice %>
      <div class="notification is-success is-light has-text-centered mb-0" style="border-radius: 0;"><%= notice %></div>
    <% end %>
    <% if alert %>
      <div class="notification is-danger is-light has-text-centered mb-0" style="border-radius: 0;"><%= alert %></div>
    <% end %>

    <%= yield %>

    <footer class="footer mt-6" style="background-color: #f9f9f9;">
      <div class="content has-text-centered">
        <p class="is-size-7">
          <strong>AMPM PRO AUDIO</strong> © 2026 - RRC Agile Project
        </p>
      </div>
    </footer>
  </body>
</html>