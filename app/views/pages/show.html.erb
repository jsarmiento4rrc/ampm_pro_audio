<div class="container mt-6 py-6">
  <div class="box shadow-smooth p-6">
    <h1 class="title is-2 mb-5"><%= @page.title %></h1>
    
    <div class="content is-medium">
      <%# simple_format automatically turns double line-breaks into paragraphs %>
      <%= simple_format(@page.content) %>
    </div>
  </div>
</div>

<style>
  .shadow-smooth {
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    border-radius: 8px;
  }
</style>