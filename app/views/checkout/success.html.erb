<div class="container has-text-centered mt-6 pt-5">
  <div class="box py-6 shadow-smooth">
    <span class="icon is-large has-text-success mb-5">
      <i class="fas fa-check-circle fa-4x"></i>
    </span>
    
    <h1 class="title is-1">Thank You!</h1>
    <p class="subtitle is-4">Your payment was processed successfully.</p>
    
    <div class="columns is-centered">
      <div class="column is-6">
        <div class="notification is-success is-light">
          <p class="is-size-5">
            Order Reference: <strong>#<%= @order.id %></strong>
          </p>
          <p>A confirmation email has been sent to <strong><%= current_customer.email %></strong>.</p>
        </div>
      </div>
    </div>

    <div class="content mt-5">
      <p class="has-text-grey">
        Total Charged: <span class="has-text-weight-bold"><%= number_to_currency(@order.total) %></span>
      </p>
    </div>

    <div class="buttons is-centered mt-6">
      <%= link_to orders_path, class: "button is-link is-large" do %>
        <span class="icon"><i class="fas fa-history"></i></span>
        <span>View My Order History</span>
      <% end %>
      
      <%= link_to root_path, class: "button is-light is-large" do %>
        <span class="icon"><i class="fas fa-home"></i></span>
        <span>Back to Store</span>
      <% end %>
    </div>
  </div>
</div>

<style>
  .shadow-smooth {
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    border-radius: 12px;
  }
</style>